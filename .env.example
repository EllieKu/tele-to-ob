# 從 @BotFather 取得的 Bot Token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 你自己的 Telegram user id（正數）
# 取得方式：傳訊息給 @userinfobot，它會直接回覆你的 id
# 支援多人（逗號分隔）：123456,789012
# 只有白名單內的 id 能觸發抓取，其他人的訊息一律靜默忽略
TELEGRAM_ALLOWED_USER_IDS=123456789

# 選填：限定只處理特定群組的訊息（私聊模式不需要填）
# 取得方式：把 bot 加入群組後傳訊息，再查 getUpdates 找 "chat":{"id": ...}
# TELEGRAM_GROUP_ID=-1001234567890

# Obsidian Vault 在這台電腦上的絕對路徑
# Windows：C:\Users\yourname\Documents\MyVault
OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/MyVault

# Vault 內要存放剪輯內容的子資料夾
OBSIDIAN_CLIP_FOLDER=Clippings

# (Optional)未設定時，收到圖片訊息會忽略並印出警告
TELEGRAM_IMAGE_SAVE_PATH=/Users/yourname/Pictures/TelegramClips
